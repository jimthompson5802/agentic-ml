
{
  "name": "Agentic ML + Codex",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "remoteUser": "vscode",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },

  "mounts": [
    "source=agentic-ml-codex-home,target=/home/vscode/.codex,type=volume",
    "source=${localEnv:HOME}/.codex/config.toml,target=/tmp/host-codex/config.toml,type=bind,readonly",
    "source=${localEnv:HOME}/.codex/skills,target=/tmp/host-codex/skills,type=bind,readonly",
    "source=${localEnv:HOME}/.codex/rules,target=/tmp/host-codex/rules,type=bind,readonly",
    "source=agentic-ml-pytest-tmp,target=/pytest-tmp,type=volume"
  ],

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false
      }
    }
  }
}
