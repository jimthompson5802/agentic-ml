+def test_mutating_installed_guidance_preserves_peers_and_cache(
+    installed_project: tuple[Path, str, str], tmp_path: Path
+) -> None:
+    """Copy-isolated corruption leaves hardlinked peers and future installs intact."""
+    project, repository, revision = installed_project
+    relative = Path(
+        ".venv/lib/python3.12/site-packages/agentic_ml/runtime_guidance/provisional.md"
+    )
+    expected = (
+        b"Provisional Milestone 0 runtime guidance; experiment execution "
+        b"is unavailable.\n"
+    )
+
+    def install_peer(name: str) -> Path:
+        """Install a read-only peer through the public full-SHA uv interface."""
+        target = tmp_path / name
+        target.mkdir()
+        env = dict(os.environ, UV_LINK_MODE="hardlink")
+        for key in (
+            "VIRTUAL_ENV",
+            "UV_PROJECT_ENVIRONMENT",
+            "PYTHONPATH",
+            "PYTHONHOME",
+        ):
+            env.pop(key, None)
+        for command in (
+            ["git", "init"],
+            ["uv", "init", "--no-package", "--python", "3.12"],
+            ["uv", "add", "git+" + repository, "--rev", revision],
+        ):
+            result = subprocess.run(
+                command,
+                cwd=target,
+                env=env,
+                capture_output=True,
+                text=True,
+                timeout=120,
+                check=False,
+            )
+            assert result.returncode == 0, result.stdout + result.stderr
+        return target / relative
+
+    guidance = project / relative
+    first_peer = install_peer("first-peer")
+    assert guidance.read_bytes() == first_peer.read_bytes() == expected
+    assert guidance.stat().st_nlink == 1
+    assert not guidance.samefile(first_peer)
+    try:
+        guidance.write_text("Unexpected guidance.\n")
+        result = probe_project(project, repository, revision)
+        assert result.returncode != 0
+        assert "runtime guidance contents differ" in result.stderr
+        assert first_peer.read_bytes() == expected
+        second_peer = install_peer("second-peer")
+        assert second_peer.read_bytes() == expected
+        assert first_peer.samefile(second_peer)
+    finally:
+        guidance.write_bytes(expected)
+
+
