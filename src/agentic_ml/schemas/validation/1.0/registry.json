{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "algorithms": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "interface_version": {
            "const": "1.0"
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "classification",
                "regression"
              ]
            }
          },
          "adapter": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "library": {
            "type": "object",
            "properties": {
              "distribution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "reference_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "distribution",
              "reference_version"
            ],
            "additionalProperties": false
          },
          "parameters": {
            "type": "object",
            "maxProperties": 1000,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "types": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 5,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "null",
                      "boolean",
                      "integer",
                      "float",
                      "string"
                    ]
                  }
                },
                "default": {
                  "type": [
                    "null",
                    "boolean",
                    "integer",
                    "number",
                    "string"
                  ]
                },
                "choices": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1000,
                  "items": {
                    "type": [
                      "null",
                      "boolean",
                      "integer",
                      "number",
                      "string"
                    ]
                  }
                },
                "minimum": {
                  "type": "number"
                },
                "maximum": {
                  "type": "number"
                }
              },
              "required": [
                "types",
                "default"
              ],
              "additionalProperties": false
            }
          },
          "requires_non_null": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "properties": {
                "if_parameter": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
                },
                "equals": {
                  "type": [
                    "null",
                    "boolean",
                    "integer",
                    "number",
                    "string"
                  ]
                },
                "then_parameter": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
                }
              },
              "required": [
                "if_parameter",
                "equals",
                "then_parameter"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "interface_version",
          "tasks",
          "adapter",
          "library",
          "parameters",
          "requires_non_null"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "algorithms"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
